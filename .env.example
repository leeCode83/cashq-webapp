# kredensial zkPass DevHub (https://dev.zkpass.org) — salin ke .env
VITE_ZKPASS_APPID=uuid-project-anda
VITE_ZKPASS_SCHEMA_ID=uuid-schema-anda

# App ID publik Privy (https://dashboard.privy.io) — aman di browser
VITE_PRIVY_APP_ID=appid-app-privy-anda

# Private key wallet owner (mint faucet & sweep) — TESTNET SAJA, jangan wallet beraset.
# Ambil dari deployer `cashq-sc` (0xb8d9...a0Be). Terbaca siapa pun dari bundle web.
VITE_OWNER_PRIVATE_KEY=kunci-privat-hex-owner
